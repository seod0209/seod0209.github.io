---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../consts';
import { slugify, formatDate, excerpt } from '../../utils';

export async function getStaticPaths() {
  const drafts = await getCollection('drafts');
  return drafts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const desc = excerpt(post.body ?? '', 160);
---

<Base title={`[초안] ${post.data.title}`} description={desc} article={true}>
  <article class="post">
    <p style="margin:0 0 1rem;padding:.5rem .75rem;background:#fff3cd;border:1px solid #ffe69c;border-radius:8px;font-size:.85rem;">
      📝 초안 미리보기 — 아직 발행되지 않은 글입니다. <a href="/drafts/">전체 초안 목록</a>
    </p>
    <h1 class="post-title">{post.data.title}</h1>

    <div class="post-header-meta">
      <span>Draft {formatDate(post.data.date)}</span>
      <span class="dot">·</span>
      <span>By {SITE.author}</span>
    </div>

    {
      post.data.tags.length > 0 && (
        <div class="post-tags">
          {post.data.tags.map((t) => (
            <span class="post-tag">{t}</span>
          ))}
        </div>
      )
    }

    <div class="post-content">
      <Content />
    </div>
  </article>
</Base>
