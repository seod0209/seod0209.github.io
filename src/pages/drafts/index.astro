---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../consts';
import { slugify, excerpt, formatDate } from '../../utils';

const drafts = (await getCollection('drafts')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
---

<Base title="Drafts (미리보기)" description="발행 전 초안 로컬 미리보기">
  <div class="container">
    <header class="pub-header">
      <div class="pub-meta">
        <h1 class="pub-title">📝 Drafts — 미리보기</h1>
        <p class="pub-tagline">발행 전 초안 {drafts.length}편. 이 페이지는 로컬에서만 보이며 발행 목록에 포함되지 않습니다.</p>
      </div>
    </header>

    <div class="post-grid">
      {
        drafts.map((d, i) => {
          const cat = d.data.categories?.[0] ?? 'Draft';
          const href = `/drafts/${d.id}/`;
          return (
            <article class="grid-card" data-path={href}>
              <a href={href}>
                <div class={`thumb thumb-ph grad-${i % 6}`}>
                  <span>{cat}</span>
                </div>
                <div class="grid-body">
                  <h3 class="grid-title">{d.data.title}</h3>
                  <p class="grid-excerpt">{excerpt(d.body ?? '', 130)}</p>
                  <div class="card-meta">
                    <span>{SITE.author}</span>
                    <span class="dot">·</span>
                    <span>{formatDate(d.data.date)}</span>
                  </div>
                </div>
              </a>
            </article>
          );
        })
      }
    </div>
  </div>
</Base>
