---
import '../styles/global.css';
import { SITE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const { title, description = SITE.description, image, article = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = image ? new URL(image, SITE.url).href : undefined;
const isProd = import.meta.env.PROD;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/img/favicons/favicon.ico" />
    <link rel="apple-touch-icon" href="/assets/img/favicons/apple-touch-icon.png" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    {
      isProd && (
        <script
          async
          src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8291738466849150"
          crossorigin="anonymous"
        />
      )
    }
    {
      isProd && (
        <script
          async
          src="https://gc.zgo.at/count.js"
          data-goatcounter={`https://${SITE.goatcounterId}.goatcounter.com/count`}
        />
      )
    }
  </head>
  <body>
    <header class="topbar">
      <div class="container topbar-inner">
        <a class="brand" href="/">{SITE.title}</a>
        <nav>
          <a href="/">Home</a>
          <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">© {new Date().getFullYear()} {SITE.author}</div>
    </footer>

    <div id="capture-guard-toast" role="alert" aria-live="assertive"></div>

    <script is:inline>
      (function () {
        var toast = document.getElementById('capture-guard-toast');
        var timer;
        function warn(msg) {
          if (!toast) return;
          toast.textContent = msg;
          toast.classList.add('show');
          clearTimeout(timer);
          timer = setTimeout(function () { toast.classList.remove('show'); }, 2600);
        }
        function inProtected(el) {
          return el && el.closest && el.closest('.post-content, .post-title, .grid-card');
        }
        ['copy', 'cut'].forEach(function (ev) {
          document.addEventListener(ev, function (e) {
            if (inProtected(e.target)) {
              e.preventDefault();
              warn('⚠️ 복사가 제한된 콘텐츠입니다.');
            }
          });
        });
        document.addEventListener('contextmenu', function (e) {
          if (inProtected(e.target)) {
            e.preventDefault();
            warn('⚠️ 우클릭 메뉴가 제한됩니다.');
          }
        });
        document.addEventListener('dragstart', function (e) {
          if (inProtected(e.target)) e.preventDefault();
        });
        function isShotShortcut(e) {
          if (e.key === 'PrintScreen') return true;
          // macOS(⌘⇧3/4/5), 일부 스니핑 도구(⌃/⌘ + ⇧ + S)
          if (e.shiftKey && (e.metaKey || e.ctrlKey) &&
              ['3', '4', '5', 's', 'S'].indexOf(e.key) !== -1) return true;
          return false;
        }
        document.addEventListener('keydown', function (e) {
          if (isShotShortcut(e)) warn('⚠️ 화면 캡처 단축키가 감지되었습니다. 이 콘텐츠는 보호됩니다.');
        });
        document.addEventListener('keyup', function (e) {
          if (e.key === 'PrintScreen') {
            try { navigator.clipboard && navigator.clipboard.writeText(''); } catch (_) {}
            warn('⚠️ 화면 캡처가 감지되었습니다. 이 콘텐츠는 보호됩니다.');
          }
        });
      })();
    </script>
  </body>
</html>
